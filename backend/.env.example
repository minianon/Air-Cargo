# ================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ================================================
# Copy this file to .env and configure your values
# All variables are loaded via src/config/env.js
# ================================================

# Server Configuration
# --------------------
# Port for the backend server
PORT=3001

# Environment mode (development, production, test)
NODE_ENV=development

# CORS Configuration  
# -------------------
# Allowed origins for CORS (comma-separated for multiple)
# Use '*' to allow all origins (development only!)
# In production, set to your frontend URL
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# ----------------------
# Path to SQLite database file (optional, has default)
# DB_PATH=./data/cargo.db

# Logging Configuration
# ---------------------
# Log level: error, warn, info, debug
LOG_LEVEL=info
