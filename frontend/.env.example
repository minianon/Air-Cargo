# ================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ================================================
# Copy this file to .env and configure your values
# Variables must be prefixed with VITE_ to be exposed
# ================================================

# Backend API URL
# ---------------
# Leave empty/unset for development (uses Vite proxy)
# Set to your deployed backend URL for production
#
# Development (uses proxy in vite.config.js):
#   Leave commented or empty
#
# Production (Vercel):
#   VITE_API_URL=https://your-backend.railway.app
#
VITE_API_URL=
